# ==============================================================================
# CLIMA-SHIELD — .gitignore
# Full-Stack (React/Vite Frontend + FastAPI Python Backend)
# ==============================================================================

# --- Node & Frontend Dependencies & Outputs ---
node_modules/
frontend/node_modules/
.pnp
.pnp.js
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
build/
out/
.vite/
frontend/.vite/
.cache/
.eslintcache

# --- Python Bytecode & Runtime ---
__pycache__/
*/__pycache__/
**/*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Python Virtual Environments ---
.venv/
venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# --- Testing & Coverage ---
coverage/
frontend/coverage/
.nyc_output/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Local Databases & Data Stores ---
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite3

# --- Environment Variables & Secrets ---
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local
!.env.example
*.pem
*.key
*.cert

# --- Logs & Diagnostics ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- IDE & Editor Configurations ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Temporary & Local Scratch Files ---
tmp/
temp/
run.txt